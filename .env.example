# ==============================================================================
# TrustMark - Environment Variables Example
# Copy this file to .env.local (frontend) or .env (backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Environment Variables (backend/.env)
# ------------------------------------------------------------------------------

# Your Google Cloud Project ID
GCP_PROJECT_ID="your-google-cloud-project-id"

# The Google Cloud Storage bucket where original and watermarked assets are stored
GCS_BUCKET_NAME="your-trustmark-assets-bucket"

# Vertex AI Location (default: us-central1)
VERTEX_LOCATION="us-central1"

# Allowed CORS origins (comma-separated, no spaces)
# For local dev: http://localhost:3001
# For production: https://your-trustmark-app.web.app
ALLOWED_ORIGINS="http://localhost:3001,https://trustmark.web.app"

# Base URL of the frontend (used to generate certificate URLs)
FRONTEND_BASE_URL="http://localhost:3001"

# Path to your service account key file (required for local development only)
# In Cloud Run, the application default credentials are used automatically.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"


# ------------------------------------------------------------------------------
# Frontend Environment Variables (frontend/.env.local)
# ------------------------------------------------------------------------------

# The URL of your running FastAPI backend
# Local dev: http://localhost:8000
# Production: https://your-cloud-run-url.a.run.app
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Firebase Client Configuration
# Get these values from your Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
